# Cloudflare Workers Assets serves everything with
# `Cache-Control: public, max-age=0, must-revalidate` by default, which costs a
# revalidation round trip per asset on every repeat visit. Everything under
# /assets/ is emitted by Vite with a content hash in the filename, so a new
# build produces a new URL and the response can be cached indefinitely.
#
# The SSR document is generated by the Worker, not served from assets, so it is
# unaffected by this file and keeps revalidating as it should.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
